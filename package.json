{
  "name": "university-admission-checker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate:data": "node scripts/validate-data.mjs",
    "build:data-package": "node scripts/build-data-package.mjs",
    "pack:data": "npm run build:data-package && npm pack ./packages/myanmar-university-admission-data",
    "publish:data": "npm run build:data-package && npm publish ./packages/myanmar-university-admission-data --access public"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vite": "^5.3.1"
  }
}
